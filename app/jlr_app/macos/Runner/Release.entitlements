<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox DESLIGADO: o app precisa acessar a porta serial do Mongoose
	     (/dev/cu.usbmodem*). App de diagnóstico local, fora da Mac App Store. -->
